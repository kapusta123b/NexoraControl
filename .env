#FOR COMPOSE

# Use 'openssl rand -hex 32' to generate a strong key
SECRET_KEY=django-insecure-your-secret-key-here

# Comma-separated list of hosts (e.g., 127.0.0.1,example.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

DEBUG=False

# --- DATABASE SETTINGS ---
# Information:
#  Keep in mind that the values ​​for DB_NAME, DB_USER, and DB_PASS
#  are the ones PostgreSQL will use when creating the image;
#  so, if you want a different database name, password, or username
#  you should change them in the fields below.

POSTGRES_DB=nexora_control
POSTGRES_USER=nexora_control_user
POSTGRES_PASSWORD=password
DB_HOST=db # db is the service name in compose.yml, rename it if you change the service name
DB_PORT=5432