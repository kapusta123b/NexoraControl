QFrame#agent_command_fields_container QPlainTextEdit,
QFrame#agent_command_fields_container QTextEdit,
QFrame#fleet_command_fields_container QPlainTextEdit,
QFrame#fleet_command_fields_container QTextEdit {
    min-height: 75px; font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
}

QFrame#agent_command_fields_container QComboBox::drop-down,
QFrame#agent_command_fields_container QFontComboBox::drop-down,
QFrame#fleet_command_fields_container QComboBox::drop-down,
QFrame#fleet_command_fields_container QFontComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-left: 1px solid #30495A;
    background: #192D3B;
}

QFrame#agent_command_fields_container QComboBox QAbstractItemView,
QFrame#agent_command_fields_container QFontComboBox QAbstractItemView,
QFrame#fleet_command_fields_container QComboBox QAbstractItemView,
QFrame#fleet_command_fields_container QFontComboBox QAbstractItemView {
    background-color: #142431;
    color: #D9E5EE;
    border: 1px solid #466477;
    selection-background-color: #31546A;
    selection-color: #F3F7F9;
    outline: 0;
}

/* Numeric values look like ordinary clean inputs: no spin-button chrome.
   In Python also use QAbstractSpinBox.ButtonSymbols.NoButtons to remove
   the reserved sub-control area completely. */
QFrame#agent_command_fields_container QSpinBox::up-button,
QFrame#agent_command_fields_container QSpinBox::down-button,
QFrame#agent_command_fields_container QDoubleSpinBox::up-button,
QFrame#agent_command_fields_container QDoubleSpinBox::down-button,
QFrame#fleet_command_fields_container QSpinBox::up-button,
QFrame#fleet_command_fields_container QSpinBox::down-button,
QFrame#fleet_command_fields_container QDoubleSpinBox::up-button,
QFrame#fleet_command_fields_container QDoubleSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
}

/* Date/time inputs may retain their native step controls. */
QFrame#agent_command_fields_container QDateEdit::up-button,
QFrame#agent_command_fields_container QDateTimeEdit::up-button,
QFrame#agent_command_fields_container QTimeEdit::up-button,
QFrame#fleet_command_fields_container QDateEdit::up-button,
QFrame#fleet_command_fields_container QDateTimeEdit::up-button,
QFrame#fleet_command_fields_container QTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #30495A;
    background-color: #1A303E;
}

QFrame#agent_command_fields_container QDateEdit::down-button,
QFrame#agent_command_fields_container QDateTimeEdit::down-button,
QFrame#agent_command_fields_container QTimeEdit::down-button,
QFrame#fleet_command_fields_container QDateEdit::down-button,
QFrame#fleet_command_fields_container QDateTimeEdit::down-button,
QFrame#fleet_command_fields_container QTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #30495A;
    background-color: #1A303E;
}

QFrame#agent_command_fields_container QDateEdit::drop-down,
QFrame#agent_command_fields_container QDateTimeEdit::drop-down,
QFrame#agent_command_fields_container QTimeEdit::drop-down,
QFrame#fleet_command_fields_container QDateEdit::drop-down,
QFrame#fleet_command_fields_container QDateTimeEdit::drop-down,
QFrame#fleet_command_fields_container QTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #30495A;
    background-color: #1A303E;
}

QFrame#agent_command_fields_container QCheckBox,
QFrame#agent_command_fields_container QRadioButton,
QFrame#fleet_command_fields_container QCheckBox,
QFrame#fleet_command_fields_container QRadioButton {
    color: #C0D3E0;
    spacing: 9px;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QFrame#agent_command_fields_container QCheckBox::indicator,
QFrame#agent_command_fields_container QRadioButton::indicator,
QFrame#fleet_command_fields_container QCheckBox::indicator,
QFrame#fleet_command_fields_container QRadioButton::indicator {
    width: 16px; height: 16px;
}

/* Dynamic command parameter checkboxes: visible on dark surfaces.
   Scoped to the two command builders; no icons or extra files needed. */
QFrame#agent_command_fields_container QCheckBox::indicator:unchecked,
QFrame#fleet_command_fields_container QCheckBox::indicator:unchecked {
    width: 16px;
    height: 16px;
    background-color: #101F2A;
    border: 1px solid #7893A5;
    border-radius: 4px;
}

QFrame#agent_command_fields_container QCheckBox::indicator:unchecked:hover,
QFrame#fleet_command_fields_container QCheckBox::indicator:unchecked:hover {
    background-color: #1D3646;
    border: 1px solid #A4C9DD;
}

QFrame#agent_command_fields_container QCheckBox::indicator:checked,
QFrame#fleet_command_fields_container QCheckBox::indicator:checked {
    width: 16px;
    height: 16px;
    background-color: #91C3D7;
    border: 1px solid #B5DEEB;
    border-radius: 4px;
}

QFrame#agent_command_fields_container QCheckBox::indicator:checked:hover,
QFrame#fleet_command_fields_container QCheckBox::indicator:checked:hover {
    background-color: #AAD7E8;
    border: 1px solid #D2ECF5;
}

QFrame#agent_command_fields_container QCheckBox::indicator:unchecked:disabled,
QFrame#fleet_command_fields_container QCheckBox::indicator:unchecked:disabled {
    background-color: #172530;
    border: 1px solid #425968;
}

QFrame#agent_command_fields_container QCheckBox::indicator:checked:disabled,
QFrame#fleet_command_fields_container QCheckBox::indicator:checked:disabled {
    background-color: #567887;
    border: 1px solid #6D8E9D;
}

QFrame#agent_command_fields_container QCheckBox:disabled,
QFrame#agent_command_fields_container QRadioButton:disabled,
QFrame#fleet_command_fields_container QCheckBox:disabled,
QFrame#fleet_command_fields_container QRadioButton:disabled {
    color: #728A9C;
}

QFrame#agent_command_fields_container QPushButton,
QFrame#agent_command_fields_container QToolButton,
QFrame#fleet_command_fields_container QPushButton,
QFrame#fleet_command_fields_container QToolButton {
    background-color: #1B3140;
    border: 1px solid #3E5C6F;
    border-radius: 4px;
    color: #D8E8F0;
    min-height: 27px;
    padding: 5px 11px;
    font-size: 11px;
}

QFrame#agent_command_fields_container QPushButton:hover,
QFrame#agent_command_fields_container QToolButton:hover,
QFrame#fleet_command_fields_container QPushButton:hover,
QFrame#fleet_command_fields_container QToolButton:hover {
    background-color: #294658; border-color: #799EB1;
}

QFrame#agent_command_fields_container QPushButton:pressed,
QFrame#agent_command_fields_container QToolButton:pressed,
QFrame#fleet_command_fields_container QPushButton:pressed,
QFrame#fleet_command_fields_container QToolButton:pressed {
    background-color: #122633;
}

QFrame#agent_command_fields_container QPushButton:disabled,
QFrame#agent_command_fields_container QToolButton:disabled,
QFrame#fleet_command_fields_container QPushButton:disabled,
QFrame#fleet_command_fields_container QToolButton:disabled {
    background-color: #182733; border-color: #2B4252; color: #718999;
}

QFrame#agent_command_fields_container QSlider::groove:horizontal,
QFrame#fleet_command_fields_container QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background-color: #314959;
}

QFrame#agent_command_fields_container QSlider::handle:horizontal,
QFrame#fleet_command_fields_container QSlider::handle:horizontal {
    background-color: #9BBCCE;
    border: 1px solid #B5D2E0;
    border-radius: 7px;
    width: 14px;
    margin: -5px 0;
}

QFrame#agent_command_fields_container QSlider::groove:vertical,
QFrame#fleet_command_fields_container QSlider::groove:vertical {
    width: 5px;
    border-radius: 2px;
    background-color: #314959;
}

QFrame#agent_command_fields_container QSlider::handle:vertical,
QFrame#fleet_command_fields_container QSlider::handle:vertical {
    background-color: #9BBCCE;
    border: 1px solid #B5D2E0;
    border-radius: 7px;
    height: 14px;
    margin: 0 -5px;
}

QFrame#agent_command_fields_container QProgressBar,
QFrame#fleet_command_fields_container QProgressBar {
    background-color: #162936;
    color: #DCE8EE;
    border: 1px solid #345063;
    border-radius: 4px;
    text-align: center;
    min-height: 16px;
}

QFrame#agent_command_fields_container QProgressBar::chunk,
QFrame#fleet_command_fields_container QProgressBar::chunk {
    background-color: #83B1C7; border-radius: 3px;
}

QFrame#agent_command_fields_container QListWidget,
QFrame#agent_command_fields_container QTreeWidget,
QFrame#agent_command_fields_container QTableWidget,
QFrame#fleet_command_fields_container QListWidget,
QFrame#fleet_command_fields_container QTreeWidget,
QFrame#fleet_command_fields_container QTableWidget {
    background-color: #0E1D28;
    alternate-background-color: #142735;
    color: #CBDDE8;
    border: 1px solid #365163;
    border-radius: 4px;
    selection-background-color: #2A4B60;
    selection-color: #F1F7FA;
    outline: none;
}

QFrame#agent_command_fields_container QListWidget::item,
QFrame#agent_command_fields_container QTreeWidget::item,
QFrame#fleet_command_fields_container QListWidget::item,
QFrame#fleet_command_fields_container QTreeWidget::item {
    padding: 5px 7px;
}

QFrame#agent_command_fields_container QHeaderView::section,
QFrame#fleet_command_fields_container QHeaderView::section {
    background-color: #203847;
    color: #AFC6D5;
    border: none;
    border-bottom: 1px solid #355366;
    padding: 6px;
    font-size: 10px;
}

QFrame#agent_command_fields_container QScrollArea,
QFrame#fleet_command_fields_container QScrollArea {
    background: transparent; border: none;
}

QFrame#agent_command_fields_container QScrollBar:vertical,
QFrame#fleet_command_fields_container QScrollBar:vertical {
    background-color: #142633; border: 0; width: 9px; margin: 0;
}

QFrame#agent_command_fields_container QScrollBar::handle:vertical,
QFrame#fleet_command_fields_container QScrollBar::handle:vertical {
    background-color: #476476; border-radius: 4px; min-height: 20px;
}

QFrame#agent_command_fields_container QScrollBar::add-line:vertical,
QFrame#agent_command_fields_container QScrollBar::sub-line:vertical,
QFrame#fleet_command_fields_container QScrollBar::add-line:vertical,
QFrame#fleet_command_fields_container QScrollBar::sub-line:vertical {
    height: 0px;
}

QFrame#agent_command_fields_container QScrollBar:horizontal,
QFrame#fleet_command_fields_container QScrollBar:horizontal {
    background-color: #142633; border: 0; height: 9px; margin: 0;
}

QFrame#agent_command_fields_container QScrollBar::handle:horizontal,
QFrame#fleet_command_fields_container QScrollBar::handle:horizontal {
    background-color: #476476; border-radius: 4px; min-width: 20px;
}

QFrame#agent_command_fields_container QScrollBar::add-line:horizontal,
QFrame#agent_command_fields_container QScrollBar::sub-line:horizontal,
QFrame#fleet_command_fields_container QScrollBar::add-line:horizontal,
QFrame#fleet_command_fields_container QScrollBar::sub-line:horizontal {
    width: 0px;
}

QFrame#agent_command_fields_container QTabWidget::pane,
QFrame#fleet_command_fields_container QTabWidget::pane {
    background-color: #10212C; border: 1px solid #344D5C;
}

QFrame#agent_command_fields_container QTabBar::tab,
QFrame#fleet_command_fields_container QTabBar::tab {
    background-color: #1A303E;
    color: #9CB3C1;
    border: 1px solid #304B5D;
    padding: 6px 13px;
}

QFrame#agent_command_fields_container QTabBar::tab:selected,
QFrame#fleet_command_fields_container QTabBar::tab:selected {
    background-color: #294658; color: #F1F7FA; border-top: 2px solid #91BCCE;
}

/* Unhandled/custom Qt widgets keep their native rendering in this area. */
