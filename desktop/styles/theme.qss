QWidget#central_content {
  background: #090e14;
  color: #d8e4ed;
  font-family: "Segoe UI", "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
  font-size: 12px;
}
QWidget#left_panel {
  background: #0c131c;
  border-right: 1px solid #223340;
}
