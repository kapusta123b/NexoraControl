/* Conditional state, driven by your existing Python dynamic properties. */
QLabel[agent_status="online"] { color: #8AC9AF; }
QLabel[agent_status="offline"] { color: #D5A1A7; }
QLabel[load_level="low"] { color: #8AC9AF; }
QLabel[load_level="medium"] { color: #D9BF91; }
QLabel[load_level="high"] { color: #D5A1A7; }
QLabel#online_count { color: #8AC9AF; }
QLabel#offline_count { color: #D5A1A7; }
QLabel#agent_command_safety_label, QLabel#fleet_command_warning {
    color: #D7C29A; }

/* Panels around commands, logs, preferences, and about: no new layout margins. */
QFrame#fleet_command_library_panel, QFrame#fleet_command_execution_panel,
QFrame#fleet_command_history_panel, QFrame#fleet_command_result_panel,
QFrame#fleet_logs_filters_panel, QFrame#fleet_logs_table_panel,
QFrame#fleet_logs_details_panel, QFrame#agent_command_form_panel,
QFrame#agent_command_output_panel, QFrame#agent_command_history_panel,
QFrame#preferences_connection_panel, QFrame#about_identity_panel {
    background: #111B25; border: 1px solid #283A48; border-radius: 3px; }
QFrame#fleet_command_execution_panel, QFrame#agent_command_form_panel {
    border-top: 2px solid #698BA0; }
QFrame#preferences_connection_panel, QFrame#about_identity_panel {
    background: #101924; border-color: #2A3C4A; }

/* Existing resource / inventory / overview panels. */
QWidget#card_agents, QWidget#card_online, QWidget#card_offline,
QWidget#cpu_widget, QWidget#ram_widget, QWidget#disk_widget,
QWidget#uptime_widget, QWidget#system_status_box_widget,
QWidget#quick_actions_widget,
QWidget#cpu_info_widget, QWidget#memory_info_widget,
QWidget#gpu_info_widget, QWidget#motherboard_info_widget,
QWidget#bios_info_widget, QWidget#disk_io_summary_widget,
QWidget#ram_utilization_widget, QWidget#network_health_errors_widget,
QWidget#network_health_drops_widget, QWidget#network_health_total_widget,
QWidget#hardware_storage_inventory_panel,
QWidget#hardware_network_inventory_panel,
QWidget#hardware_platform_panel {
    background: #111B25; border: 1px solid #283A48; border-radius: 3px; }
QWidget#cpu_info_box_widget, QWidget#memory_info_box_widget,
QWidget#gpu_info_box_widget, QWidget#motherboard_info_box_widget,
QWidget#bios_info_box_widget, QWidget#recent_command_box_widget { background: transparent; border: none; }
QWidget#compute_gauge_widget, QWidget#storage_gauge_widget,
QWidget#thermals_gauge_widget, QWidget#network_gauge_widget {
    background: #111B25; border: 1px solid #283A48; border-radius: 3px; }
PlotWidget#cpu_ram_metric_graph, PlotWidget#load_average_metric_graph,
PlotWidget#cpu_cores_metric_graph, PlotWidget#disk_write_read_graph,
PlotWidget#thermals_graph, PlotWidget#network_graph {
    background: #0B151F; border: 1px solid #273B49; border-radius: 2px; }

/* Buttons: action-first hierarchy. No pill shapes or oversized back navigation. */
QPushButton { background: #192631; border: 1px solid #314653;
    color: #D2E0E9; border-radius: 3px; padding: 4px 10px;
    font-size: 11px; font-weight: 500; min-height: 26px; }
QPushButton:hover { background: #223442; border-color: #5B7B8E; color: #F3F7FA; }
QPushButton:pressed { background: #101B25; }
QPushButton:disabled { color: #637787; background: #111923; border-color: #283742; }
QPushButton#back_to_agents_button {
    background: transparent; border: 1px solid transparent;
    color: #9AB0BF; font-size: 11px; font-weight: 500; text-align: left;
    padding: 2px 4px; min-height: 27px; }
QPushButton#back_to_agents_button:hover { color: #EAF1F5; background: #14212C; border-color: #283E4D; }
QPushButton#back_to_agents_button:pressed { background: #1D303F; }
QPushButton#fleet_command_send_button, QPushButton#agent_command_execute_button,
QPushButton#preferences_save_button {
    color: #09121A; background: #95B7CA; border-color: #A4C5D5; font-weight: 600; }
QPushButton#fleet_command_send_button:hover, QPushButton#agent_command_execute_button:hover,
QPushButton#preferences_save_button:hover { background: #B0CBD9; border-color: #C4D9E4; }
QPushButton#fleet_command_validate_button, QPushButton#agent_command_validate_button {
    color: #C6DBE8; background: #142532; border-color: #38556A; }
QPushButton#reboot_quick_button, QPushButton#stop_all_docker_cont_quick_button {
    color: #DBB9B5; background: #261D23; border-color: #6B4348; }
QPushButton#reboot_quick_button:hover, QPushButton#stop_all_docker_cont_quick_button:hover {
    background: #34252B; border-color: #9A666D; }
QPushButton#fleet_logs_clear_filters_button { background: transparent; color: #A3B5C1; }
QPushButton#fleet_logs_export_button { background: #17232D; }

/* Main navigation */
QPushButton#dashboard_button, QPushButton#agents_button,
QPushButton#commands_button, QPushButton#logs_button,
QPushButton#settings_button, QPushButton#about_button {
    background: transparent; border: 1px solid transparent;
    border-radius: 2px; color: #9BAFBD; text-align: left;
    font-size: 12px; font-weight: 500; min-height: 30px; padding: 4px 11px; }
QPushButton#dashboard_button:hover, QPushButton#agents_button:hover,
QPushButton#commands_button:hover, QPushButton#logs_button:hover,
QPushButton#settings_button:hover, QPushButton#about_button:hover {
    background: #172733; color: #E3EDF3; }
QPushButton#dashboard_button:checked, QPushButton#agents_button:checked,
QPushButton#commands_button:checked, QPushButton#logs_button:checked,
QPushButton#settings_button:checked, QPushButton#about_button:checked {
    background: #1B2B37; border-left: 2px solid #8BAFBE; color: #EDF3F7; }
QPushButton#overview_nav_button, QPushButton#performance_nav_button,
QPushButton#hardware_nav_button, QPushButton#commands_nav_button,
QPushButton#compute_button, QPushButton#storage_button,
QPushButton#thermals_button, QPushButton#network_button,
QPushButton#network_traffic_toggle_button, QPushButton#network_packets_toggle_button {
    background: transparent; color: #94AABB; border: 1px solid transparent;
    border-radius: 1px; min-height: 27px; padding: 4px 9px; font-weight: 500; }
QPushButton#overview_nav_button:hover, QPushButton#performance_nav_button:hover,
QPushButton#hardware_nav_button:hover, QPushButton#commands_nav_button:hover,
QPushButton#compute_button:hover, QPushButton#storage_button:hover,
QPushButton#thermals_button:hover, QPushButton#network_button:hover,
QPushButton#network_traffic_toggle_button:hover, QPushButton#network_packets_toggle_button:hover {
    color: #E7F0F5; background: #172733; }
QPushButton#overview_nav_button:checked, QPushButton#performance_nav_button:checked,
QPushButton#hardware_nav_button:checked, QPushButton#commands_nav_button:checked,
QPushButton#compute_button:checked, QPushButton#storage_button:checked,
QPushButton#thermals_button:checked, QPushButton#network_button:checked,
QPushButton#network_traffic_toggle_button:checked, QPushButton#network_packets_toggle_button:checked {
    color: #EDF4F8; background: #1A2A35; border-bottom: 2px solid #8BAFBE; }

/* Interactive controls */
QLineEdit, QComboBox, QSpinBox {
    background: #0C1720; border: 1px solid #304453; border-radius: 2px;
    color: #E2EBF1; font-size: 11px; min-height: 26px;
    padding: 3px 8px; selection-background-color: #345466; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #8EAFBF; background: #101F2A; }
QLineEdit:disabled, QComboBox:disabled { color: #647A89; }
QComboBox::drop-down { background: transparent; border: none; width: 23px; }
QComboBox QAbstractItemView { background: #101E29; color: #E0EBF2;
    border: 1px solid #385262; selection-background-color: #29485C;
    selection-color: #F0F5F8; outline: 0; }
QPlainTextEdit { background: #0A141D; color: #DAE6EE; border: 1px solid #304553;
    border-radius: 2px; padding: 8px;
    font-family: "JetBrains Mono", "Consolas", monospace; font-size: 11px;
    selection-background-color: #38576A; }
QPlainTextEdit:focus { border: 1px solid #87A9BC; }
QTableWidget { background: #0D1720; alternate-background-color: #101D27;
    color: #D8E4ED; gridline-color: #263846;
    border: 1px solid #304553; border-radius: 2px; outline: 0;
    selection-background-color: #28475C; selection-color: #F2F7FA; }
QTableWidget::item { padding: 4px 7px; border-bottom: 1px solid #233643; }
QTableWidget::item:hover { background: #182936; }
QHeaderView::section { background: #172632; color: #BED0DB; border: 0;
    border-bottom: 1px solid #344A59; padding: 6px 8px;
    font-size: 10px; font-weight: 600; }
QTableCornerButton::section { background: #172632; border: none; }
QProgressBar { border: 1px solid #2B4050; background: #0C1720;
    border-radius: 2px; color: #E0EAF0; text-align: center; font-size: 10px; }
QProgressBar::chunk { background: #82A7BC; border-radius: 1px; }
QProgressBar[load_level="low"]::chunk { background: #8AC9AF; }
QProgressBar[load_level="medium"]::chunk { background: #D9BF91; }
QProgressBar[load_level="high"]::chunk { background: #D5A1A7; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: #0C1620; border: 0; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #354C5B; border-radius: 2px; min-height: 25px; }
QScrollBar::handle:vertical:hover { background: #587488; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { background: #0C1620; border: 0; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #354C5B; border-radius: 2px; min-width: 25px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }
Line { color: #263A47; background: #263A47; border: 0; }



/* agent_card form style */
QWidget#card_form {
    background-color: #151D27; border: 1px solid #2D3A47; border-radius: 2px;
    font-family: "Noto Sans", "Segoe UI", sans-serif; font-size: 11px;
}
QWidget#agent_information_widget, QWidget#system_information_widget,
QWidget#right_widget {background: transparent; border: 0;}
QLabel {background: transparent; border: 0; color: #96A8B6; font-size: 11px;}
QLabel#vps_name_label {color: #E0E7EE; font-size: 12px; font-weight: 600;}
QLabel#ip_os_label {color: #A8B5C2; font-size: 11px;}
QLabel#cpu_ram_label {color: #8C9EAD; font-family:"JetBrains Mono","Consolas",monospace;font-size:10px;}
QLabel#online_dot {color: #90BCAD; font-size: 12px;}
QLabel#online_dot[agent_status="offline"] {color: #D19B9E;}
QLabel#status_label {font-family:"JetBrains Mono","Consolas",monospace; font-size:10px; font-weight:600;color:#90BCAD;}
QLabel#status_label[agent_status="online"] {color:#90BCAD;}
QLabel#status_label[agent_status="offline"] {color:#D19B9E;}
QPushButton#agent_open_button {background:#202D3A;border:1px solid #3E5567;border-radius:2px;color:#C8DAE4;
    min-height:27px;padding:3px 12px;font-size:11px;font-weight:600;}
QPushButton#agent_open_button:hover {background:#293B4A;border-color:#98B0C2;color:#ECF3F7;}
QPushButton#agent_open_button:pressed {background:#0F202B;}

/* recent_command_widget form style */
QWidget#recent_command_widget {background:#151D27;border-bottom:1px solid #2D3A47;
    font-family:"Noto Sans","Segoe UI",sans-serif;font-size:11px;}
QLabel {background:transparent;border:none;color:#BECBD5;font-size:11px;}
QLabel#command_mark {font-size:12px;color:#90BCAD;}
QLabel#command_mark[status="success"] {color:#90BCAD;}
QLabel#command_mark[status="failed"] {color:#D19B9E;}
QLabel#command_mark[status="pending"] {color:#D2B98F;}
QLabel#command_name {color:#DAE4EA;font-family:"JetBrains Mono","Consolas",monospace;font-size:11px;}
QLabel#command_status {color:#90BCAD;font-family:"JetBrains Mono","Consolas",monospace;font-size:10px;font-weight:600;}
QLabel#command_status[status="success"] {color:#90BCAD;}
QLabel#command_status[status="failed"] {color:#D19B9E;}
QLabel#command_status[status="pending"] {color:#D2B98F;}
QLabel#command_executed_time {color:#738897;font-size:10px;}


#fleet_commands_page, #agent_commands_page,
#fleet_commands_page_scroll, #agent_commands_page_scroll,
#fleet_commands_page_scroll_content, #agent_commands_page_scroll_content {
  background: #0C141D; color: #DCE5EC; font: 11px "Noto Sans", "Inter", "DejaVu Sans";
}
#fleet_commands_page QLabel, #agent_commands_page QLabel {
  background: transparent; border: none; color: #CEDAE2;
}
#fleet_cmd_title, #agent_cmd_title { font-size: 20px; font-weight: 650; color: #F2F5F7; }
#fleet_cmd_subtitle, #agent_cmd_subtitle { color: #92A6B6; font-size: 11px; }
#fleet_command_workspace_status, #agent_command_target_indicator {
  color: #93BDCA; background: #152733; border: 1px solid #315064;
  padding: 7px 10px; border-radius: 4px; font-size: 10px; font-weight: 600;
}
#fleet_command_process_strip, #agent_command_process_strip {
  background: #10232E; border: 1px solid #234353; border-radius: 3px;
}
#fleet_command_process_steps, #agent_command_process_steps {
  color: #91B4C8; font-size: 10px; font-weight: 600;
}
#fleet_command_library_panel, #fleet_command_execution_panel,
#fleet_command_review_panel, #fleet_command_history_panel, #fleet_command_result_panel,
#agent_command_form_panel, #agent_command_review_panel,
#agent_command_output_panel, #agent_command_history_panel {
  background: #141E29; border: 1px solid #2C3E4D; border-radius: 5px;
}
#fleet_command_library_panel_header, #fleet_command_execution_panel_header,
#fleet_command_review_header, #fleet_command_history_panel_header,
#fleet_command_result_panel_header, #agent_command_form_panel_header,
#agent_command_review_header, #agent_command_output_panel_header,
#agent_command_history_panel_header {
  color: #F0F4F7; font-size: 12px; font-weight: 700;
}
#fleet_command_library_panel_caption, #fleet_command_execution_panel_caption,
#fleet_command_review_caption, #fleet_command_history_panel_caption,
#fleet_command_result_panel_caption, #agent_command_form_panel_caption,
#agent_command_review_caption, #agent_command_output_panel_caption,
#fleet_command_library_help, #fleet_command_catalog_summary,
#fleet_command_target_hint, #fleet_command_raw_hint, #agent_command_raw_hint,
#fleet_command_review_footer, #agent_command_review_footer {
  color: #8EA4B4; font-size: 10px;
}
#fleet_command_fields_label, #agent_command_fields_label,
#fleet_command_payload_label, #agent_command_payload_label,
#fleet_command_target_label, #fleet_command_selected_label,
#agent_command_category_label, #agent_command_type_label,
#fleet_command_review_payload_label, #agent_command_review_payload_label,
#fleet_command_recent_section_label, #agent_command_recent_section_label {
  color: #A8BAC6; font-size: 10px; font-weight: 700;
}
#fleet_command_fields_count, #agent_command_fields_count {
  color: #7FB8C7; font-size: 10px;
}
#fleet_command_identity_card, #agent_command_identity_card {
  background: #182A36; border: 1px solid #355365; border-radius: 4px;
}
#fleet_command_display_title, #agent_command_display_title {
  color: #F1F5F7; font-size: 15px; font-weight: 700;
}
#fleet_command_command_key, #agent_command_command_key {
  color: #89A9BB; font-family: "JetBrains Mono", "DejaVu Sans Mono"; font-size: 10px;
}
#fleet_command_description, #agent_command_description {
  color: #C0D0DB; font-size: 11px;
}
#fleet_command_risk_badge, #agent_command_risk_badge,
#fleet_command_review_risk, #agent_command_review_risk {
  color: #9ED5BD; background: #17372F; border: 1px solid #315B4B;
  border-radius: 3px; padding: 4px 8px; font-size: 10px; font-weight: 700;
}
#fleet_command_risk_badge[risk="moderate"], #agent_command_risk_badge[risk="moderate"],
#fleet_command_review_risk[risk="moderate"], #agent_command_review_risk[risk="moderate"] {
  color: #E9C48D; background: #3A2C21; border-color: #70563A;
}
#fleet_command_risk_badge[risk="dangerous"], #agent_command_risk_badge[risk="dangerous"],
#fleet_command_review_risk[risk="dangerous"], #agent_command_review_risk[risk="dangerous"] {
  color: #EBA6A6; background: #3D252B; border-color: #754650;
}
#fleet_command_fields_container, #agent_command_fields_container {
  background: #0F1A24; border: 1px solid #34495B; border-radius: 4px;
}
#fleet_commands_page QLineEdit, #agent_commands_page QLineEdit,
#fleet_commands_page QComboBox, #agent_commands_page QComboBox,
#fleet_commands_page QPlainTextEdit, #agent_commands_page QPlainTextEdit,
#fleet_commands_page QSpinBox, #agent_commands_page QSpinBox {
  background: #0D1721; color: #DCE7EE; border: 1px solid #395061;
  border-radius: 4px; selection-background-color: #395669;
  padding: 6px 9px; font-size: 11px;
}
#fleet_commands_page QLineEdit:focus, #agent_commands_page QLineEdit:focus,
#fleet_commands_page QComboBox:focus, #agent_commands_page QComboBox:focus,
#fleet_commands_page QSpinBox:focus, #agent_commands_page QSpinBox:focus,
#fleet_commands_page QPlainTextEdit:focus, #agent_commands_page QPlainTextEdit:focus {
  border: 1px solid #90B9CC;
}
#fleet_commands_page QLineEdit[invalid="true"], #agent_commands_page QLineEdit[invalid="true"] {
  border-color: #CA7F80;
}
#fleet_commands_page QComboBox, #agent_commands_page QComboBox,
#fleet_commands_page QLineEdit, #agent_commands_page QLineEdit,
#fleet_commands_page QSpinBox, #agent_commands_page QSpinBox { min-height: 29px; }
#fleet_commands_page QComboBox::drop-down, #agent_commands_page QComboBox::drop-down {
  border: none; width: 22px;
}
#fleet_commands_page QPlainTextEdit, #agent_commands_page QPlainTextEdit {
  font-family: "JetBrains Mono", "DejaVu Sans Mono"; font-size: 10px;
}
#fleet_command_request_preview, #agent_command_request_preview {
  background: #09151E; border: 1px solid #264454; color: #B5D9E5;
}
#fleet_command_review_target, #agent_command_review_target,
#fleet_command_review_operation, #agent_command_review_operation,
#fleet_command_review_fields, #agent_command_review_fields {
  font-family: "JetBrains Mono", "DejaVu Sans Mono"; color: #B4C7D3; font-size: 10px;
}
#fleet_command_validation_status, #agent_command_validation_status {
  color: #B1C6D2; background: #172936; border-left: 3px solid #7EADC3;
  padding: 9px 11px; font-weight: 600; font-size: 10px;
}
#fleet_command_validation_status[state="valid"], #agent_command_validation_status[state="valid"] {
  color: #B0DBC7; border-left-color: #73B596; background: #173126;
}
#fleet_command_validation_status[state="invalid"], #agent_command_validation_status[state="invalid"] {
  color: #E9B6B6; border-left-color: #D4888A; background: #34252A;
}
#fleet_command_warning, #agent_command_safety_label {
  color: #AFC4D2; background: #1B2B37; border-left: 2px solid #537B91;
  padding: 9px 11px; font-size: 10px;
}
#fleet_commands_page QTableWidget, #agent_commands_page QTableWidget {
  background: #101C26; alternate-background-color: #17232E;
  color: #DBE5EC; border: 1px solid #2E4353;
  selection-background-color: #314F62; selection-color: #FAFCFD;
  gridline-color: #273846; font-size: 10px;
}
#fleet_commands_page QHeaderView::section, #agent_commands_page QHeaderView::section {
  background: #20313E; color: #A9BECF;
  border: none; border-bottom: 1px solid #3B5364;
  padding: 7px 8px; font-size: 10px; font-weight: 600;
}
#fleet_commands_page QPushButton, #agent_commands_page QPushButton {
  background: #20313D; border: 1px solid #3A5364; border-radius: 4px;
  color: #D7E6ED; padding: 6px 11px; font-size: 11px;
  min-height: 25px;
}
#fleet_commands_page QPushButton:hover, #agent_commands_page QPushButton:hover {
  background: #2A4251; border-color: #799BAF;
}
#fleet_commands_page QPushButton:disabled, #agent_commands_page QPushButton:disabled {
  background: #1A2630; color: #748896; border-color: #2D4050;
}
#fleet_command_send_button, #agent_command_execute_button {
  background: #92BCCD; color: #0D1922; border: 1px solid #ADCFDC; font-weight: 700;
}
#fleet_command_send_button:hover, #agent_command_execute_button:hover {
  background: #B3D8E5; color: #0B1921;
}
#fleet_commands_page QCheckBox, #agent_commands_page QCheckBox {
  color: #BFD0DC; font-size: 10px; spacing: 7px;
}
#fleet_commands_page QCheckBox::indicator, #agent_commands_page QCheckBox::indicator {
  width: 14px; height: 14px;
}
#fleet_commands_page QTabWidget::pane, #agent_commands_page QTabWidget::pane {
  background: #101A24; border: 1px solid #2C4150;
}
#fleet_commands_page QTabBar::tab, #agent_commands_page QTabBar::tab {
  background: #192A36; border: 1px solid #2D4352; border-bottom: 0;
  color: #8EA4B2; padding: 6px 16px;
}
#fleet_commands_page QTabBar::tab:selected, #agent_commands_page QTabBar::tab:selected {
  background: #263C4A; color: #EDF5F8; border-top: 2px solid #8EB7CB;
}
#fleet_commands_page QScrollBar:vertical, #agent_commands_page QScrollBar:vertical {
  background: #111E28; width: 8px;
}
#fleet_commands_page QScrollBar::handle:vertical, #agent_commands_page QScrollBar::handle:vertical {
  background: #3A5363; border-radius: 3px; min-height: 25px;
}
#fleet_commands_page QScrollBar::add-line:vertical, #agent_commands_page QScrollBar::add-line:vertical,
#fleet_commands_page QScrollBar::sub-line:vertical, #agent_commands_page QScrollBar::sub-line:vertical {
  height: 0px;
}

QFrame#agent_command_fields_container,
QFrame#fleet_command_fields_container {
    background-color: #0E1B26;
    border: 1px solid #34495B;
    border-radius: 5px;
}

QFrame#agent_command_fields_container QWidget,
QFrame#agent_command_fields_container QFrame,
QFrame#fleet_command_fields_container QWidget,
QFrame#fleet_command_fields_container QFrame {
    color: #D8E4EC; background-color: transparent;
}

QFrame#agent_command_fields_container QFrame[commandField="true"],
QFrame#agent_command_fields_container QWidget[commandField="true"],
QFrame#fleet_command_fields_container QFrame[commandField="true"],
QFrame#fleet_command_fields_container QWidget[commandField="true"] {
    background-color: #13232E;
    border: 1px solid #2D4657;
    border-radius: 4px;
}

/* Generated rows should flow vertically without extra boxed borders.
   Supports both row.setObjectName("command_field_row") and
   row.setProperty("fieldRole", "row"). */
QFrame#agent_command_fields_container QFrame#command_field_row,
QFrame#fleet_command_fields_container QFrame#command_field_row,
QFrame#agent_command_fields_container QFrame[fieldRole="row"],
QFrame#fleet_command_fields_container QFrame[fieldRole="row"] {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QFrame#agent_command_fields_container QGroupBox,
QFrame#fleet_command_fields_container QGroupBox {
    background-color: #12232F;
    color: #D9E6EE;
    border: 1px solid #344D5E;
    border-radius: 4px;
    margin-top: 14px;
    padding: 12px 10px 8px 10px;
    font-size: 11px;
    font-weight: 600;
}

QFrame#agent_command_fields_container QGroupBox::title,
QFrame#fleet_command_fields_container QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #AFC8D7;
}

QFrame#agent_command_fields_container QLabel,
QFrame#fleet_command_fields_container QLabel {
    background: transparent;
    border: none;
    color: #C5D5DF;
    font-size: 11px;
}

/* Dynamic field headings: match the original Qt Designer example. */
QFrame#agent_command_fields_container QLabel[fieldRole="label"],
QFrame#agent_command_fields_container QLabel[fieldRole="section"],
QFrame#fleet_command_fields_container QLabel[fieldRole="label"],
QFrame#fleet_command_fields_container QLabel[fieldRole="section"] {
    background: transparent;
    border: none;
    color: #C0D3E0;
    font-size: 10px;
    font-weight: 700;
}

QFrame#agent_command_fields_container QLabel[fieldRole="hint"],
QFrame#fleet_command_fields_container QLabel[fieldRole="hint"] {
    background: transparent;
    border: none;
    color: #829CAC;
    font-size: 10px;
    font-weight: 400;
}

QFrame#agent_command_fields_container QLabel[fieldRole="error"],
QFrame#fleet_command_fields_container QLabel[fieldRole="error"] {
    color: #DEA3A6; font-size: 10px;
}

QFrame#agent_command_fields_container QLabel[fieldRole="required"],
QFrame#fleet_command_fields_container QLabel[fieldRole="required"] {
    color: #D9B387; font-size: 10px; font-weight: 600;
}

QFrame#agent_command_fields_container QLineEdit,
QFrame#agent_command_fields_container QSpinBox,
QFrame#agent_command_fields_container QDoubleSpinBox,
QFrame#agent_command_fields_container QComboBox,
