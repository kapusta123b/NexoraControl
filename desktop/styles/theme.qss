/* Conditional state, driven by your existing Python dynamic properties. */
QLabel[agent_status="online"] {
  color: #8ac9af;
}
QLabel[agent_status="offline"] {
  color: #d5a1a7;
}
QLabel[load_level="low"] {
  color: #8ac9af;
}
QLabel[load_level="medium"] {
  color: #d9bf91;
}
QLabel[load_level="high"] {
  color: #d5a1a7;
}
QLabel#online_count {
  color: #8ac9af;
}
QLabel#offline_count {
  color: #d5a1a7;
}
QLabel#agent_command_safety_label,
QLabel#fleet_command_warning {
  color: #d7c29a;
}

/* Panels around commands, logs, preferences, and about: no new layout margins. */
