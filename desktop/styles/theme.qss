QWidget#central_content { background: #090E14; color: #D8E4ED;
    font-family: "Segoe UI", "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 12px; }
QWidget#left_panel { background: #0C131C; border-right: 1px solid #223340; }
