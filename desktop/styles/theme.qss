/* Buttons: action-first hierarchy. No pill shapes or oversized back navigation. */
QPushButton {
  background: #192631;
  border: 1px solid #314653;
  color: #d2e0e9;
  border-radius: 3px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 500;
  min-height: 26px;
}
QPushButton:hover {
  background: #223442;
  border-color: #5b7b8e;
  color: #f3f7fa;
}
QPushButton:pressed {
  background: #101b25;
}
QPushButton:disabled {
  color: #637787;
  background: #111923;
  border-color: #283742;
}
QPushButton#back_to_agents_button {
  background: transparent;
  border: 1px solid transparent;
  color: #9ab0bf;
  font-size: 11px;
  font-weight: 500;
  text-align: left;
  padding: 2px 4px;
  min-height: 27px;
}
QPushButton#back_to_agents_button:hover {
  color: #eaf1f5;
  background: #14212c;
  border-color: #283e4d;
}
QPushButton#back_to_agents_button:pressed {
  background: #1d303f;
}
QPushButton#fleet_command_send_button,
QPushButton#agent_command_execute_button,
QPushButton#preferences_save_button {
  color: #09121a;
  background: #95b7ca;
  border-color: #a4c5d5;
  font-weight: 600;
}
QPushButton#fleet_command_send_button:hover,
QPushButton#agent_command_execute_button:hover,
QPushButton#preferences_save_button:hover {
  background: #b0cbd9;
  border-color: #c4d9e4;
}
QPushButton#fleet_command_validate_button,
QPushButton#agent_command_validate_button {
  color: #c6dbe8;
  background: #142532;
  border-color: #38556a;
}
QPushButton#reboot_quick_button,
QPushButton#stop_all_docker_cont_quick_button {
  color: #dbb9b5;
  background: #261d23;
  border-color: #6b4348;
}
QPushButton#reboot_quick_button:hover,
QPushButton#stop_all_docker_cont_quick_button:hover {
  background: #34252b;
  border-color: #9a666d;
}
QPushButton#fleet_logs_clear_filters_button {
  background: transparent;
  color: #a3b5c1;
}
QPushButton#fleet_logs_export_button {
  background: #17232d;
}

/* Main navigation */
QPushButton#dashboard_button,
QPushButton#agents_button,
QPushButton#commands_button,
QPushButton#logs_button,
QPushButton#settings_button,
QPushButton#about_button {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 2px;
  color: #9bafbd;
  text-align: left;
  font-size: 12px;
  font-weight: 500;
  min-height: 30px;
  padding: 4px 11px;
}
QPushButton#dashboard_button:hover,
QPushButton#agents_button:hover,
QPushButton#commands_button:hover,
QPushButton#logs_button:hover,
QPushButton#settings_button:hover,
QPushButton#about_button:hover {
  background: #172733;
  color: #e3edf3;
}
QPushButton#dashboard_button:checked,
QPushButton#agents_button:checked,
QPushButton#commands_button:checked,
QPushButton#logs_button:checked,
QPushButton#settings_button:checked,
QPushButton#about_button:checked {
  background: #1b2b37;
  border-left: 2px solid #8bafbe;
  color: #edf3f7;
}
QPushButton#overview_nav_button,
QPushButton#performance_nav_button,
QPushButton#hardware_nav_button,
QPushButton#commands_nav_button,
QPushButton#compute_button,
QPushButton#storage_button,
QPushButton#thermals_button,
QPushButton#network_button,
QPushButton#network_traffic_toggle_button,
QPushButton#network_packets_toggle_button {
  background: transparent;
  color: #94aabb;
  border: 1px solid transparent;
  border-radius: 1px;
  min-height: 27px;
  padding: 4px 9px;
  font-weight: 500;
}
QPushButton#overview_nav_button:hover,
QPushButton#performance_nav_button:hover,
QPushButton#hardware_nav_button:hover,
QPushButton#commands_nav_button:hover,
QPushButton#compute_button:hover,
QPushButton#storage_button:hover,
QPushButton#thermals_button:hover,
QPushButton#network_button:hover,
QPushButton#network_traffic_toggle_button:hover,
QPushButton#network_packets_toggle_button:hover {
  color: #e7f0f5;
  background: #172733;
}
QPushButton#overview_nav_button:checked,
QPushButton#performance_nav_button:checked,
QPushButton#hardware_nav_button:checked,
QPushButton#commands_nav_button:checked,
QPushButton#compute_button:checked,
QPushButton#storage_button:checked,
QPushButton#thermals_button:checked,
QPushButton#network_button:checked,
QPushButton#network_traffic_toggle_button:checked,
QPushButton#network_packets_toggle_button:checked {
  color: #edf4f8;
  background: #1a2a35;
  border-bottom: 2px solid #8bafbe;
}

/* Interactive controls */
QLineEdit,
QComboBox,
QSpinBox {
  background: #0c1720;
  border: 1px solid #304453;
  border-radius: 2px;
  color: #e2ebf1;
  font-size: 11px;
  min-height: 26px;
  padding: 3px 8px;
  selection-background-color: #345466;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
  border: 1px solid #8eafbf;
  background: #101f2a;
}
QLineEdit:disabled,
QComboBox:disabled {
  color: #647a89;
}
QComboBox::drop-down {
  background: transparent;
  border: none;
  width: 23px;
}
QComboBox QAbstractItemView {
  background: #101e29;
  color: #e0ebf2;
  border: 1px solid #385262;
  selection-background-color: #29485c;
  selection-color: #f0f5f8;
  outline: 0;
}
QPlainTextEdit {
  background: #0a141d;
  color: #dae6ee;
  border: 1px solid #304553;
  border-radius: 2px;
  padding: 8px;
  font-family: "JetBrains Mono", "Consolas", monospace;
  font-size: 11px;
  selection-background-color: #38576a;
}
QPlainTextEdit:focus {
  border: 1px solid #87a9bc;
}
QTableWidget {
  background: #0d1720;
  alternate-background-color: #101d27;
  color: #d8e4ed;
  gridline-color: #263846;
  border: 1px solid #304553;
  border-radius: 2px;
  outline: 0;
  selection-background-color: #28475c;
  selection-color: #f2f7fa;
}
QTableWidget::item {
  padding: 4px 7px;
  border-bottom: 1px solid #233643;
}
QTableWidget::item:hover {
  background: #182936;
}
QHeaderView::section {
  background: #172632;
  color: #bed0db;
  border: 0;
  border-bottom: 1px solid #344a59;
  padding: 6px 8px;
  font-size: 10px;
  font-weight: 600;
}
QTableCornerButton::section {
  background: #172632;
  border: none;
}
QProgressBar {
  border: 1px solid #2b4050;
  background: #0c1720;
  border-radius: 2px;
  color: #e0eaf0;
  text-align: center;
  font-size: 10px;
}
QProgressBar::chunk {
  background: #82a7bc;
  border-radius: 1px;
}
QProgressBar[load_level="low"]::chunk {
  background: #8ac9af;
}
QProgressBar[load_level="medium"]::chunk {
  background: #d9bf91;
}
QProgressBar[load_level="high"]::chunk {
  background: #d5a1a7;
}
QScrollArea {
  background: transparent;
  border: none;
}
QScrollArea > QWidget > QWidget {
  background: transparent;
}
QScrollBar:vertical {
  background: #0c1620;
  border: 0;
  width: 8px;
  margin: 0;
}
QScrollBar::handle:vertical {
  background: #354c5b;
  border-radius: 2px;
  min-height: 25px;
}
QScrollBar::handle:vertical:hover {
  background: #587488;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
}
QScrollBar:horizontal {
  background: #0c1620;
  border: 0;
  height: 8px;
  margin: 0;
}
QScrollBar::handle:horizontal {
  background: #354c5b;
  border-radius: 2px;
  min-width: 25px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  width: 0;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: none;
}
Line {
  color: #263a47;
  background: #263a47;
  border: 0;
}

/* agent_card form style */
QWidget#card_form {
  background-color: #151d27;
  border: 1px solid #2d3a47;
  border-radius: 2px;
  font-family: "Noto Sans", "Segoe UI", sans-serif;
  font-size: 11px;
}
QWidget#agent_information_widget,
QWidget#system_information_widget,
QWidget#right_widget {
  background: transparent;
  border: 0;
}
QLabel {
  background: transparent;
  border: 0;
  color: #96a8b6;
  font-size: 11px;
}
QLabel#vps_name_label {
  color: #e0e7ee;
  font-size: 12px;
  font-weight: 600;
}
QLabel#ip_os_label {
  color: #a8b5c2;
  font-size: 11px;
}
QLabel#cpu_ram_label {
  color: #8c9ead;
  font-family: "JetBrains Mono", "Consolas", monospace;
  font-size: 10px;
}
QLabel#online_dot {
  color: #90bcad;
  font-size: 12px;
}
QLabel#online_dot[agent_status="offline"] {
  color: #d19b9e;
}
QLabel#status_label {
  font-family: "JetBrains Mono", "Consolas", monospace;
  font-size: 10px;
  font-weight: 600;
  color: #90bcad;
}
QLabel#status_label[agent_status="online"] {
  color: #90bcad;
}
QLabel#status_label[agent_status="offline"] {
  color: #d19b9e;
}
QPushButton#agent_open_button {
  background: #202d3a;
  border: 1px solid #3e5567;
  border-radius: 2px;
  color: #c8dae4;
  min-height: 27px;
  padding: 3px 12px;
  font-size: 11px;
  font-weight: 600;
}
QPushButton#agent_open_button:hover {
  background: #293b4a;
  border-color: #98b0c2;
  color: #ecf3f7;
}
QPushButton#agent_open_button:pressed {
  background: #0f202b;
}

/* recent_command_widget form style */
QWidget#recent_command_widget {
  background: #151d27;
  border-bottom: 1px solid #2d3a47;
  font-family: "Noto Sans", "Segoe UI", sans-serif;
  font-size: 11px;
}
QLabel {
  background: transparent;
  border: none;
  color: #becbd5;
  font-size: 11px;
}
QLabel#command_mark {
  font-size: 12px;
  color: #90bcad;
}
QLabel#command_mark[status="success"] {
  color: #90bcad;
}
QLabel#command_mark[status="failed"] {
  color: #d19b9e;
}
QLabel#command_mark[status="pending"] {
  color: #d2b98f;
}
QLabel#command_name {
  color: #dae4ea;
  font-family: "JetBrains Mono", "Consolas", monospace;
  font-size: 11px;
}
QLabel#command_status {
  color: #90bcad;
  font-family: "JetBrains Mono", "Consolas", monospace;
  font-size: 10px;
  font-weight: 600;
}
QLabel#command_status[status="success"] {
  color: #90bcad;
}
QLabel#command_status[status="failed"] {
  color: #d19b9e;
}
QLabel#command_status[status="pending"] {
  color: #d2b98f;
}
QLabel#command_executed_time {
  color: #738897;
  font-size: 10px;
}

