  spacing: 9px;
  font-size: 11px;
  font-weight: 600;
  background: transparent;
  border: none;
}

QFrame#agent_command_fields_container QCheckBox::indicator,
QFrame#agent_command_fields_container QRadioButton::indicator,
QFrame#fleet_command_fields_container QCheckBox::indicator,
QFrame#fleet_command_fields_container QRadioButton::indicator {
  width: 16px;
  height: 16px;
}

/* Dynamic command parameter checkboxes: visible on dark surfaces.
   Scoped to the two command builders; no icons or extra files needed. */
QFrame#agent_command_fields_container QCheckBox::indicator:unchecked,
QFrame#fleet_command_fields_container QCheckBox::indicator:unchecked {
  width: 16px;
  height: 16px;
  background-color: #101f2a;
  border: 1px solid #7893a5;
  border-radius: 4px;
}

QFrame#agent_command_fields_container QCheckBox::indicator:unchecked:hover,
QFrame#fleet_command_fields_container QCheckBox::indicator:unchecked:hover {
  background-color: #1d3646;
  border: 1px solid #a4c9dd;
}

QFrame#agent_command_fields_container QCheckBox::indicator:checked,
QFrame#fleet_command_fields_container QCheckBox::indicator:checked {
  width: 16px;
  height: 16px;
  background-color: #91c3d7;
  border: 1px solid #b5deeb;
  border-radius: 4px;
}

QFrame#agent_command_fields_container QCheckBox::indicator:checked:hover,
QFrame#fleet_command_fields_container QCheckBox::indicator:checked:hover {
  background-color: #aad7e8;
  border: 1px solid #d2ecf5;
}

QFrame#agent_command_fields_container QCheckBox::indicator:unchecked:disabled,
QFrame#fleet_command_fields_container QCheckBox::indicator:unchecked:disabled {
  background-color: #172530;
  border: 1px solid #425968;
}

QFrame#agent_command_fields_container QCheckBox::indicator:checked:disabled,
QFrame#fleet_command_fields_container QCheckBox::indicator:checked:disabled {
  background-color: #567887;
  border: 1px solid #6d8e9d;
}

QFrame#agent_command_fields_container QCheckBox:disabled,
QFrame#agent_command_fields_container QRadioButton:disabled,
QFrame#fleet_command_fields_container QCheckBox:disabled,
QFrame#fleet_command_fields_container QRadioButton:disabled {
