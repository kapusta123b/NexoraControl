}

QFrame#agent_command_fields_container QTabBar::tab:selected,
QFrame#fleet_command_fields_container QTabBar::tab:selected {
  background-color: #294658;
  color: #f1f7fa;
  border-top: 2px solid #91bcce;
}

/* Unhandled/custom Qt widgets keep their native rendering in this area. */

/* -------------------------------------------------------------------------
   Settings page | connection, refresh behavior, safety and app information
   ------------------------------------------------------------------------- */
QFrame#preferences_connection_panel,
QFrame#preferences_refresh_panel,
QFrame#preferences_safety_panel,
QFrame#preferences_application_panel {
  background: #101924;
  border: 1px solid #2a3c4a;
  border-radius: 4px;
}

QLabel#preferences_connection_panel_header,
QLabel#preferences_refresh_panel_header,
QLabel#preferences_safety_panel_header {
  font-size: 12px;
  font-weight: 700;
  color: #dde9f0;
}

QLabel#preferences_connection_panel_caption,
QLabel#preferences_refresh_panel_caption,
QLabel#preferences_safety_panel_caption,
QLabel#preferences_endpoint_hint,
QLabel#preferences_refresh_interval_hint,
QLabel#preferences_safety_note,
QLabel#preferences_app_info_caption {
  color: #879dae;
  font-size: 11px;
}

QLabel#preferences_endpoint_label,
QLabel#preferences_interval_label,
QLabel#preferences_request_timeout_label,
QLabel#preferences_app_version_label {
  color: #b8cbd7;
  font-size: 10px;
  font-weight: 700;
}

QLineEdit#preferences_endpoint_edit,
QComboBox#preferences_refresh_interval_combo,
QSpinBox#preferences_request_timeout_spin {
  color: #d7e4ec;
  background: #0b141d;
  border: 1px solid #2e4555;
  border-radius: 3px;
  padding: 7px 9px;
  selection-background-color: #456b82;
  selection-color: #f4f8fa;
}

QLineEdit#preferences_endpoint_edit:focus,
QComboBox#preferences_refresh_interval_combo:focus,
QSpinBox#preferences_request_timeout_spin:focus {
  border: 1px solid #80afc7;
  background: #0d1923;
}

QLabel#preferences_connection_status_label {
  color: #b4c5d0;
  background: #172632;
  border: 1px solid #354c5b;
  border-radius: 3px;
  padding: 4px 8px;
  font-family: "JetBrains Mono", "Consolas", monospace;
  font-size: 9px;
  font-weight: 700;
}

QPushButton#preferences_test_connection_button,
QPushButton#preferences_reset_button {
  color: #c6dbe8;
  background: #142532;
  border: 1px solid #38556a;
  border-radius: 3px;
  padding: 7px 13px;
  font-weight: 600;
}

QPushButton#preferences_test_connection_button:hover,
QPushButton#preferences_reset_button:hover {
  background: #1a303f;
  border-color: #587c91;
}

QPushButton#preferences_test_connection_button:pressed,
QPushButton#preferences_reset_button:pressed {
  background: #203847;
}

QPushButton#preferences_save_button {
  min-height: 34px;
  padding-left: 18px;
  padding-right: 18px;
}

QLabel#preferences_save_status_label {
  color: #879dae;
  font-size: 11px;
}

QLabel#preferences_app_version_value {
  color: #b5c8d4;
  font-size: 10px;
  font-family: "JetBrains Mono", "Consolas", monospace;
}

QWidget#preferences_page QCheckBox {
  color: #c2d2dc;
  spacing: 8px;
  font-size: 11px;
  background: transparent;
}

QWidget#preferences_page QCheckBox::indicator {
  width: 15px;
  height: 15px;
  border: 1px solid #587083;
  border-radius: 3px;
  background: #0b141d;
}

QWidget#preferences_page QCheckBox::indicator:hover {
  border-color: #8bafc4;
}

QWidget#preferences_page QCheckBox::indicator:checked {
  background: #8fb6cb;
  border: 1px solid #b2d0df;
}

QWidget#preferences_page QCheckBox::indicator:disabled {
  background: #17232d;
  border-color: #344654;
}


/* Settings feedback states: connection test and local-save status only. */
QLabel#preferences_connection_status_label[connectionState="connected"] {
  color: #9adbc4;
  background: #142b29;
  border-color: #32665a;
}

QLabel#preferences_connection_status_label[connectionState="auth"] {
  color: #e6c98a;
  background: #2b261a;
  border-color: #6a5832;
}

QLabel#preferences_connection_status_label[connectionState="testing"] {
  color: #a8d4ed;
  background: #172a39;
  border-color: #365d75;
}

QLabel#preferences_connection_status_label[connectionState="warning"] {
  color: #e6c98a;
  background: #2b261a;
  border-color: #6a5832;
}

QLabel#preferences_connection_status_label[connectionState="error"] {
  color: #f1a6a8;
  background: #301e24;
  border-color: #75404a;
}

QLabel#preferences_connection_status_label[connectionState="neutral"] {
  color: #b4c5d0;
  background: #172632;
  border-color: #354c5b;
}

QLabel#preferences_save_status_label[saveState="saved"] {
  color: #9adbc4;
}

QLabel#preferences_save_status_label[saveState="dirty"] {
  color: #e6c98a;
}

QLabel#preferences_save_status_label[saveState="error"] {
  color: #f1a6a8;
}

QPushButton#preferences_test_connection_button:disabled {
  color: #718795;
  background: #101a23;
  border-color: #293946;
}
